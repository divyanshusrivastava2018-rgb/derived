PORT=3000
# Use production on every public host (Render, VPS, etc.). GitHub Actions Pages build sets this automatically.
NODE_ENV=development

# Required in production (npm start exits if missing when NODE_ENV=production)
RESEARCHIUM_ADMIN_USERNAME=admin
# Generate: openssl rand -base64 32 — never use the placeholder below in production
RESEARCHIUM_ADMIN_PASSWORD=

# Optional: comma-separated extra login IDs (exact match, lowercase)
# RESEARCHIUM_ADMIN_LOGIN_ALIASES=

# Signed httpOnly cookie for demo/pro entitlements (use a long random string)
RESEARCHIUM_MEMBER_SECRET=change-me-member-signing-secret

# Allow POST /api/member/demo-unlock in production (default: only non-production)
# ALLOW_DEMO_MEMBER=1

# Production site origin(s) for CORS (comma-separated). Include GitHub Pages if you use static Pages + API on derived.co.in.
# CORS_ORIGIN=https://www.derived.co.in,https://divyanshusrivastava2018-rgb.github.io
# SITE_URL=https://www.example.com

# Behind reverse proxy (nginx, etc.)
# TRUST_PROXY=1

# YouTube Data API v3 (admin playlist import only)
# YOUTUBE_API_KEY=
# YOUTUBE_CHANNEL_URL=

# Contact form → inbox (required for email delivery)
CONTACT_TO_EMAIL=your-inbox@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Use the Gmail account that sends mail (often same as inbox)
SMTP_USER=your-gmail@gmail.com
# Gmail → Google Account → Security → 2-Step Verification → App passwords
SMTP_PASS=your-16-char-app-password
# SMTP_FROM=Researchium <your-gmail@gmail.com>

# hCaptcha on contact, leads, and doubts — required in production (https://www.hcaptcha.com/)
# HCAPTCHA_SITE_KEY=
# HCAPTCHA_SECRET_KEY=
# Local dev only: allow forms without hCaptcha (never set in production)
# ALLOW_CONTACT_WITHOUT_CAPTCHA=1

# Study assistant on CSIR page (server-side only — never shown to visitors)
# OPENAI_API_KEY=sk-...
# AI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# GATE exam step-by-step solutions (server-side only — gate-exam review panel)
# Prefer Anthropic (matches GATE Question Solver prompt) or OpenAI:
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# GATE answer keys via env (production — avoids committing secrets)
# GATE_ANSWERS_JSON={"answers":{"ga1":1,"ga2":0}}

# Offline client scoring (static hosting only — not secure). Default: off when NODE_ENV=production.
# GATE_OFFLINE_SCORING=0
# GATE_OFFLINE_SCORING=1
# Obfuscation pepper for public/data/gate-score-bundle.json (must match gate-bundle-decode.js if customized)
# GATE_OFFLINE_BUNDLE_PEPPER=

# Progress API signing (optional; falls back to RESEARCHIUM_MEMBER_SECRET)
# RESEARCHIUM_PROGRESS_SECRET=

# Dev/smoke only — allow submit without session (never set in production)
# GATE_ALLOW_STATELESS_SUBMIT=1

# Stream studio (Researchium_stream/) — proxied when using npm start
# Educator login for POST /api/stream/auth/login (JWT signed with RESEARCHIUM_MEMBER_SECRET)
STREAM_STUDIO_EMAIL=admin@derived.co.in
STREAM_STUDIO_PASSWORD=your_password_here
# RESEARCHIUM_STREAM_API_URL=http://127.0.0.1:4000
# RESEARCHIUM_STUDIO_BACKEND_URL=http://127.0.0.1:5050
# Same secret as API_KEY in Researchium_stream/.env (admin → Stream hosts tab)
# RESEARCHIUM_STREAM_API_KEY=
