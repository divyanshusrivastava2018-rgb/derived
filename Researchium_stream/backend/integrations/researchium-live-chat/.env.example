# Researchium Live Chat Integration — copy to .env or repo root .env

# Master switch
RESEARCHIUM_CHAT_ENABLED=1

# API key for Researchium → your server (X-API-Key header)
RESEARCHIUM_INTEGRATION_API_KEY=change-me-use-openssl-rand-hex-32

# Webhook HMAC secret (Researchium signs with X-Researchium-Signature: sha256=<hex>)
RESEARCHIUM_WEBHOOK_SECRET=change-me-use-openssl-rand-hex-32

# PostgreSQL (required for production persistence)
DATABASE_URL=postgresql://researchium:password@127.0.0.1:5432/researchium
# RESEARCHIUM_CHAT_STORE=postgres   # postgres | memory | auto
# RESEARCHIUM_CHAT_DATABASE_URL=    # optional override

# Core API sync (optional — mirrors messages to studio_messages)
API_INTERNAL_URL=http://127.0.0.1:4000

# Retry / limits
RESEARCHIUM_WEBHOOK_MAX_ATTEMPTS=5
RESEARCHIUM_WEBHOOK_RETRY_BASE_MS=1000
RESEARCHIUM_WEBHOOK_RETRY_MAX_MS=60000
RESEARCHIUM_OUTBOUND_MAX_ATTEMPTS=3
RESEARCHIUM_OUTBOUND_TIMEOUT_MS=8000
RESEARCHIUM_MESSAGE_MAX_LENGTH=2000
RESEARCHIUM_CHAT_RATE_LIMIT=120

# Standalone server only
# RESEARCHIUM_CHAT_HOST=0.0.0.0
# RESEARCHIUM_CHAT_PORT=5060
