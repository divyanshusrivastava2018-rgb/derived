# See repo root .env.example for full platform keys, RTMP, and rate limits.

STUDIO_BACKEND_HOST=127.0.0.1
STUDIO_BACKEND_PORT=5050
STUDIO_METRICS_PORT=5051
API_INTERNAL_URL=http://127.0.0.1:4000
JWT_SECRET=change-me
# SESSION_EXPIRY_SEC=604800
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
FRONTEND_URL=http://127.0.0.1:5500
SKIP_REDIS=1
# Server-side WebRTC (requires: npm install wrtc). Set WEBRTC_MODE=relay to force mesh-only.
# DISABLE_SERVER_WEBRTC=1
# WEBRTC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
# REDIS_URL=redis://127.0.0.1:6379
# YouTube Live (OAuth for full API; stream key alone uses mock RTMP hints)
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# YOUTUBE_REDIRECT_URI=http://127.0.0.1:5050/api/youtube/oauth/callback
# YOUTUBE_REFRESH_TOKEN=
# YOUTUBE_CHANNEL_ID=
# YOUTUBE_STREAM_KEY=your-youtube-live-stream-key
# YOUTUBE_API_KEY=
# ENCODING_WORKER_ENABLED=0
# DISABLE_SYSTEM_METRICS=1
# METRICS_SYSTEM_INTERVAL_MS=5000

# Researchium live chat integration (see integrations/researchium-live-chat/.env.example)
# RESEARCHIUM_CHAT_ENABLED=1
# RESEARCHIUM_INTEGRATION_API_KEY=
# RESEARCHIUM_WEBHOOK_SECRET=
# DATABASE_URL=postgresql://researchium:password@127.0.0.1:5432/researchium
# ENCRYPTION_KEY=64-char-hex-from-openssl-rand-hex-32
# PUBLIC_STUDIO_URL=http://127.0.0.1:5050
# MULTISTREAM_OAUTH_SUCCESS_URL=http://127.0.0.1:5500/stream-dashboard.html?panel=destinations

# YouTube OAuth (multistream)
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# YOUTUBE_OAUTH_REDIRECT_URI=http://127.0.0.1:5050/api/multistream/oauth/youtube/callback

# Twitch
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=

# Facebook Live
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=

# LinkedIn Live
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
