# Copy to .env in project root and replace ALL secrets.
# Generate: bash scripts/generate-env-secrets.sh

NODE_ENV=development

# Local dev without Postgres: set to 1 (demo@gmail.com / demo12345 after seed)
DEV_AUTH_FALLBACK=0
AUTH_RATE_LIMIT_MAX=20
PASSWORD_RESET_RATE_LIMIT_MAX=5
GUEST_CHAT_RATE_LIMIT_MAX=30
LOG_RESET_LINKS=0

POSTGRES_USER=researchium
POSTGRES_PASSWORD=change-me-use-openssl-rand-hex-32
POSTGRES_DB=researchium
DATABASE_URL=postgresql://researchium:change-me-use-openssl-rand-hex-32@127.0.0.1:5432/researchium

JWT_SECRET=change-me-use-openssl-rand-hex-32
API_KEY=change-me-use-openssl-rand-hex-32
INTERNAL_SERVICE_KEY=change-me-use-openssl-rand-hex-32

ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

HOST=127.0.0.1
API_PORT=4000
SIGNALING_PORT=4001
STUDIO_BACKEND_PORT=5050
STUDIO_METRICS_PORT=5051
API_INTERNAL_URL=http://127.0.0.1:4000
SIGNALING_INTERNAL_URL=http://127.0.0.1:4001
SFU_PORT=4002

MAX_PEERS_PER_ROOM=50
MAX_ROOMS=500
MAX_SIGNAL_BYTES=16384
