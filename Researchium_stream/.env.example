# =============================================================================
# Researchium Stream — copy to .env and replace ALL secrets
# Generate: openssl rand -hex 32
# =============================================================================

NODE_ENV=development

# --- Database (required for multistream, chat, sessions) ---
POSTGRES_USER=researchium
POSTGRES_PASSWORD=change-me-use-openssl-rand-hex-32
POSTGRES_DB=researchium
DATABASE_URL=postgresql://researchium:change-me-use-openssl-rand-hex-32@127.0.0.1:5432/researchium

# --- Auth & encryption (required) ---
JWT_SECRET=change-me-use-openssl-rand-hex-32
API_KEY=change-me-use-openssl-rand-hex-32
INTERNAL_SERVICE_KEY=change-me-use-openssl-rand-hex-32
# AES-256-GCM key for OAuth tokens / stream keys at rest (64 hex chars = 32 bytes)
ENCRYPTION_KEY=change-me-use-openssl-rand-hex-32-change-me-use-openssl-rand-hex-32

# --- CORS & public URLs ---
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1
FRONTEND_URL=http://127.0.0.1:5500
PUBLIC_STUDIO_URL=http://127.0.0.1:5050
MULTISTREAM_OAUTH_SUCCESS_URL=http://127.0.0.1:5500/stream-dashboard.html?panel=destinations

# --- Service ports (local dev) ---
HOST=127.0.0.1
API_PORT=4000
STUDIO_BACKEND_PORT=5050
SIGNALING_PORT=4001

# --- Redis (studio backend; optional locally with SKIP_REDIS=1) ---
REDIS_URL=redis://127.0.0.1:6379
SKIP_REDIS=1

# Public self-registration on studio-lobby (default: off — use admin API / Researchium admin)
# STUDIO_ALLOW_PUBLIC_REGISTER=0

# --- Rate limiting ---
API_RATE_LIMIT_MAX=100
OAUTH_RATE_LIMIT_MAX=40
CHAT_RATE_LIMIT_MAX=120
RTMP_RATE_LIMIT_MAX=30
GOLIVE_RATE_LIMIT_MAX=20
PLATFORM_API_RETRY_MAX=3
PLATFORM_HTTP_TIMEOUT_MS=20000
OAUTH_REFRESH_BUFFER_MS=300000

# --- RTMP ingest (OBS → local server → distribute to platforms) ---
RTMP_INGEST_ENABLED=1
RTMP_PUBLIC_HOST=127.0.0.1
RTMP_PUBLIC_PORT=1935
RTMP_HLS_PORT=8088
RTMP_APP_NAME=live
RTMP_INTERNAL_URL=rtmp://127.0.0.1:1935/live
RTMP_HLS_PUBLIC_URL=http://127.0.0.1:8088/hls
RTMP_SERVICE_HOST=rtmp
FFMPEG_PATH=ffmpeg

# --- YouTube Live OAuth ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_OAUTH_REDIRECT_URI=http://127.0.0.1:5050/api/multistream/oauth/youtube/callback
YOUTUBE_STREAM_KEY=

# --- Twitch OAuth ---
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_OAUTH_REDIRECT_URI=http://127.0.0.1:5050/api/multistream/oauth/twitch/callback

# --- Facebook Live OAuth ---
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_OAUTH_REDIRECT_URI=http://127.0.0.1:5050/api/multistream/oauth/facebook/callback

# --- LinkedIn OAuth ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_OAUTH_REDIRECT_URI=http://127.0.0.1:5050/api/multistream/oauth/linkedin/callback

# --- OBS WebSocket (optional studio controls) ---
OBS_WEBSOCKET_HOST=127.0.0.1
OBS_WEBSOCKET_PORT=4455
OBS_WEBSOCKET_PASSWORD=

# --- Researchium live chat integration ---
RESEARCHIUM_CHAT_ENABLED=0
RESEARCHIUM_INTEGRATION_API_KEY=
RESEARCHIUM_WEBHOOK_SECRET=

# --- Docker Compose overrides ---
# NGINX_CONF=./nginx.conf
# STUDIO_BACKEND_PORT=5000

# --- Signaling / WebRTC (core API) ---
MAX_PEERS_PER_ROOM=50
MAX_ROOMS=500
RTC_MIN_PORT=40000
RTC_MAX_PORT=40100
