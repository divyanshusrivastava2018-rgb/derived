        "560",
        "1120",
        "350"
      ]
    },
    {
      "id": "ga3",
      "type": "MCQ",
      "marks": 1,
      "negativeMarks": 0.33,
      "text": "Antonym of BREVITY is:",
      "options": [
        "Conciseness",
        "Verbosity",
        "Clarity",
        "Speed"
      ]
    },
    {
      "id": "ga4",
      "type": "MCQ",
      "marks": 1,
      "negativeMarks": 0.33,
      "text": "A train 120 m long passes a pole in 8 s. Its speed (km/h) is:",
      "options": [
        "54",
        "45",
        "60",
        "72"
      ]
    },
    {
      "id": "ga5",
      "type": "MCQ",
      "marks": 1,
      "negativeMarks": 0.33,
      "text": "Select the correctly spelled word:",
      "options": [
        "Accomodate",
        "Accommodate",
        "Acommodate",
        "Acomodate"
      ]
    },
    {
      "id": "ga6",
      "type": "MCQ",
      "marks": 2,
      "negativeMarks": 0.67,
      "text": "In a class, 60% students passed in Math and 70% in English. If 50% passed in both, % failed in at least one subject is:",
      "options": [
        "20",
        "30",
        "40",
        "50"
      ]
    },
    {
      "id": "ga7",
      "type": "MCQ",
      "marks": 2,
      "negativeMarks": 0.67,
      "text": "Statement: All researchers are curious. Some curious people are inventors. Conclusion: Some researchers may be inventors.",
      "options": [
        "Valid",
        "Invalid",
        "Cannot be determined",
        "None"
      ]
    },
    {
      "id": "ga8",
      "type": "MCQ",
      "marks": 2,
      "negativeMarks": 0.67,
      "text": "If \\(x^{2} - 5x + 6 = 0\\), the sum of the roots is:",
      "options": [
        "\\(5\\)",
        "\\(6\\)",
        "\\(-5\\)",
        "\\(-6\\)"
      ]
    },
    {
      "id": "ga9",
      "type": "MCQ",
      "marks": 2,
      "negativeMarks": 0.67,
      "text": "A shopkeeper marks an item 25% above cost and gives 10% discount. Profit % is:",
      "options": [
        "12.5",
        "15",
        "10",
        "20"
      ]
    },
    {
      "id": "ga10",
      "type": "MCQ",
      "marks": 2,
      "negativeMarks": 0.67,
      "text": "Choose the best order: (P) Practice regularly (Q) Master concepts (R) Analyze mistakes (S) Improve scores",
      "options": [
        "Q-P-R-S",
        "P-Q-R-S",
        "Q-R-P-S",
        "P-R-Q-S"
      ]
    },
    {
      "id": "ma1",
      "type": "MCQ",
      "marks": 1,
      "negativeMarks": 0.33,
      "text": "Let \\(A\\) be \\(3\\times 4\\) and \\(B\\) be \\(4\\times 3\\) with real entries such that \\(AB\\) is non-singular. Statements: P: \\(\\operatorname{nullity}(A)=0\\); Q: \\(BA\\) is non-singular.",
      "options": [
        "Both P & Q are TRUE",
        "P is TRUE, Q is FALSE",
        "P is FALSE, Q is TRUE",
        "Both P and Q are FALSE"
      ]
    },
    {
      "id": "ma2",
      "type": "MCQ",
      "marks": 1,
      "negativeMarks": 0.33,
      "text": "A Möbius transformation maps \\(0\\to 10\\), \\(-i\\to 5-5i\\), and \\(\\infty\\to 5+5i\\). The image of \\(\\{z:\\operatorname{Re}(z)<0\\}\\) is:",
      "options": [
        "\\(|w|<5\\)",
        "\\(|w|>5\\)",
        "\\(|w-5|<5\\)",
        "\\(|w-5|>5\\)"
      ]
    },
    {
      "id": "ma3",
      "type": "MCQ",
      "marks": 1,
      "negativeMarks": 0.33,
      "text": "If \\(f(z)=u+iv\\) is analytic and non-constant, define \\(g_1=u_{x} - i u_{y}\\) and \\(g_2=v_{x} + i v_{y}\\). Then:",
      "options": [
        "Both \\(g_1\\) and \\(g_2\\) are analytic",
        "\\(g_1\\) is analytic, \\(g_2\\) is not analytic",
        "\\(g_1\\) is not analytic, \\(g_2\\) is analytic",
        "Neither \\(g_1\\) nor \\(g_2\\) is analytic"
      ]
    },
    {
      "id": "ma4",
      "type": "MCQ",
      "marks": 1,
      "negativeMarks": 0.33,
      "text": "Let \\(R\\) be the RREF of a \\(4\\times 4\\) matrix \\(A\\), with third column \\([0,1,0,0]^{T}\\). Statements: P: If \\([\\alpha\\ \\beta\\ \\gamma\\ 0]^{T}\\) solves \\(Ax=0\\) then \\(\\gamma=0\\). Q: \\(\\operatorname{rank}[A|b]=\\operatorname{rank}[R|b]\\) for all \\(b\\).",
      "options": [
        "Both TRUE",
        "P TRUE, Q FALSE",
        "P FALSE, Q TRUE",
        "Both FALSE"
      ]
    },
    {
      "id": "ma5",
      "type": "MCQ",
      "marks": 1,
      "negativeMarks": 0.33,
      "text": "For \\(y''+\\lambda y=0\\) with \\(y(0)=0\\) and \\(y(\\pi)-y'(\\pi)=0\\), \\(\\lambda>0\\), the eigenvalues satisfy:",
      "options": [
        "\\(\\lambda=(n\\pi)^{2}\\)",
        "\\(\\lambda=n^{2}\\)",
        "\\(\\lambda=k_n^{2}\\) where \\(k-\\tan(k\\pi)=0\\)",
        "\\(\\lambda=k_n^{2}\\) where \\(k+\\tan(k\\pi)=0\\)"
      ]
    },
    {
      "id": "ma6",
      "type": "MCQ",
      "marks": 2,
      "negativeMarks": 0.67,
      "text": "Family \\(u = xy + f(x^{2}-y^{2})\\) satisfies PDE:",
      "options": [
        "\\(y\\,u_{x} + x\\,u_{y} = x^{2}+y^{2}\\)",
        "\\(x\\,u_{x} + y\\,u_{y} = x^{2}+y^{2}\\)",
        "\\(y\\,u_{x} + x\\,u_{y} = x^{2}-y^{2}\\)",
        "\\(x\\,u_{x} + y\\,u_{y} = x^{2}-y^{2}\\)"
      ]
    },
    {
      "id": "ma7",
      "type": "MCQ",
      "marks": 2,
      "negativeMarks": 0.67,
      "text": "Wave equation: \\(u_{tt} = u_{xx}\\), \\(u(x,0)=0\\), \\(u_{t}(x,0)=4x\\,e^{-x^{2}}\\). Then \\(u(5,5)\\) equals:",
      "options": [
        "\\(1 - e^{-100}\\)",
